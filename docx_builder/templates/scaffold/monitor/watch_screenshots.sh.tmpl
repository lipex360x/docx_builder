#!/usr/bin/env bash
set -euo pipefail

watch_dir="${1:-${HOME}/Desktop}"
inbox="${2:-.work/_inbox}"
interval="${WATCH_INTERVAL:-2}"

mkdir -p "${inbox}"
echo "watching ${watch_dir} for new *.png; moving into ${inbox} (Ctrl-C to stop)"

while true; do
  for png in "${watch_dir}"/*.png; do
    [ -e "${png}" ] || continue
    mv "${png}" "${inbox}/"
    echo "moved $(basename "${png}")"
  done
  sleep "${interval}"
done
