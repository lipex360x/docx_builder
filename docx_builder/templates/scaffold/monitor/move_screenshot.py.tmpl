#!/usr/bin/env python3
from __future__ import annotations

import shutil
import sys
from pathlib import Path


def move_latest(source_dir: Path, inbox: Path) -> Path | None:
    pngs = sorted(source_dir.glob("*.png"), key=lambda candidate: candidate.stat().st_mtime)
    if not pngs:
        return None
    inbox.mkdir(parents=True, exist_ok=True)
    latest = pngs[-1]
    destination = inbox / latest.name
    shutil.move(str(latest), str(destination))
    return destination


def main(argv: list[str] | None = None) -> int:
    arguments = sys.argv[1:] if argv is None else argv
    source_dir = Path(arguments[0]) if arguments else Path.home() / "Desktop"
    inbox = Path(arguments[1]) if len(arguments) > 1 else Path(".work") / "_inbox"
    moved = move_latest(source_dir, inbox)
    if moved is None:
        print(f"no *.png found in {source_dir}")
        return 1
    print(f"moved {moved.name} -> {inbox}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
